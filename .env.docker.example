# Opsional. Salin menjadi .env (di folder yang sama dengan docker-compose.yml).
# Tanpa file ini pun `docker compose up -d --build` sudah jalan.

# Admin pertama, dibuat sekali saat database masih kosong.
# Kalau ADMIN_PASSWORD kosong, sandi acak dicetak sekali di log: docker compose logs app
ADMIN_EMAIL=admin@receh.local
ADMIN_PASSWORD=

# Sandi database internal. Tentukan SEBELUM menjalankan pertama kali;
# mengubahnya setelah database terbentuk membuat aplikasi tidak bisa terhubung.
DB_PASSWORD=receh-local

# Alamat akses. Default hanya komputer ini, port 8080.
# APP_BIND=0.0.0.0 supaya bisa dibuka dari HP/laptop lain di jaringan yang sama.
APP_BIND=127.0.0.1
APP_PORT=8080

APP_TIMEZONE=Asia/Jakarta

# Masuk dengan Google (opsional). Kosongkan GOOGLE_CLIENT_ID untuk mematikan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
