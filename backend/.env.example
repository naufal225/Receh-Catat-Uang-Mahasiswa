# Salin menjadi .env. Semua nilai bersifat opsional.

ADDR=:8080
# MySQL 8.0.16+ (perlu CHECK constraint). Database dibuat otomatis kalau belum ada.
# Default di bawah cocok dengan MySQL bawaan Laragon/XAMPP (root tanpa sandi).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=receh
DB_MAX_OPEN_CONNS=20
# Opsional: DSN lengkap, menimpa semua DB_* di atas.
# DB_DSN=receh:rahasia@tcp(db.internal:3306)/receh

# Cache di memori server. 0 = matikan.
# Sesi & pengguna (dibaca di setiap request). Cabut perangkat, suspend, dan
# freeze tetap berlaku seketika karena cache-nya langsung dihapus.
SESSION_CACHE_TTL=30s
# Hasil dashboard. Setiap perubahan data langsung membuat cache lama tidak terpakai.
DASHBOARD_CACHE_TTL=60s

# Folder hasil build frontend. Kalau tidak ada, server hanya melayani API.
STATIC_DIR=../frontend/dist
# Menentukan "hari ini" untuk jadwal transaksi rutin.
APP_TIMEZONE=Asia/Jakarta
RECURRING_SWEEP_EVERY=1h

# Admin pertama, dibuat sekali saat database masih kosong.
# Kalau ADMIN_PASSWORD kosong, sandi acak dibuat dan dicetak sekali di log.
ADMIN_EMAIL=admin@receh.local
ADMIN_PASSWORD=

# Set true di produksi (HTTPS).
COOKIE_SECURE=false
# Set true hanya kalau server ada di belakang reverse proxy tepercaya.
# Tanpa proxy, klien bisa memalsukan IP di audit log lewat X-Forwarded-For.
TRUST_PROXY=false

# Layanan lokasi IP. IP publik pengguna dikirim ke layanan ini saat login.
# IP lokal/privat tidak pernah dikirim. Kosongkan untuk mematikan pencarian lokasi.
GEOIP_URL=https://ipwho.is/

# Masuk dengan Google (OAuth 2.0 + PKCE). Kosongkan GOOGLE_CLIENT_ID untuk mematikan.
# Buat di Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# GOOGLE_REDIRECT_URL harus SAMA PERSIS dengan salah satu "Authorized redirect URIs" di sana:
#   dev (Vite, npm run dev):     http://localhost:5173/api/auth/google/callback
#   produksi lokal (satu proses): http://localhost:8080/api/auth/google/callback
# Client secret cukup di file ini (sudah di .gitignore); jangan di-commit atau dikirim ke frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
